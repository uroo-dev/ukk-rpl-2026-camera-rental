{
  "name": "donezo-dashboard",
  "version": "1.0.0",
  "description": "Donezo UI — Production-ready Admin & Dashboard Template with Donezo Green Design Language",
  "scripts": {
    "build:css": "tailwindcss -i ./assets/css/tailwind-input.css -o ./assets/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./assets/css/tailwind-input.css -o ./assets/css/tailwind.css --watch",
    "build": "npm run build:css && node scripts/copy-vendor.js",
    "dev": "npm run watch:css"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17",
    "@fontsource/plus-jakarta-sans": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.0"
  },
  "dependencies": {
    "chart.js": "^4.4.7",
    "lucide": "^0.469.0"
  }
}
